# ============================================================
# Text-to-SQL ReAct Agent — settings template
# Copy to .env and fill in values. NEVER commit .env.
# Every key is optional; the defaults are in src/sql_agent/config.py.
# ============================================================

# ---------- App ----------
LOG_LEVEL=INFO

# ---------- LLM ----------
LLM_PROVIDER=openai         # openai | anthropic | vertex
# Fill in the key and model for the provider you use.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
# Claude on Vertex AI (LLM_PROVIDER=vertex); uses the service account, no API key.
# GOOGLE_CLOUD_PROJECT=
# VERTEX_LOCATION=us-east5
# VERTEX_MODEL=

# ---------- Embeddings / Vector store ----------
# The default model runs on ONNX via Chroma; any other model needs sentence-transformers.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/vector_store  # or :memory: for a per-process in-memory index
SCHEMA_TOP_K=5
REINDEX_SCHEMA_ON_STARTUP=true  # rebuild the schema index from the database at startup

# ---------- Database ----------
DATABASE_URL=mysql+pymysql://readonly_user:password@localhost:3306/customer_insights
SQL_DIALECT=mysql
# Comma-separated; empty = all tables.
ALLOWED_TABLES=
# CLOUD_SQL_INSTANCE=          # project:region:instance (Cloud SQL Python Connector)

# ---------- Web UI (ui/app.py) ----------
# The deployed agent: projects/PROJECT/locations/REGION/reasoningEngines/ID
# AGENT_ENGINE_RESOURCE=

# ---------- Guardrails ----------
READ_ONLY=true
MAX_ROWS=1000                  # LIMIT cap on every query
QUERY_TIMEOUT_SECONDS=30
MAX_AGENT_STEPS=10             # LLM turns before the agent is stopped
TOOL_RESULT_ROWS=50            # rows of a result shown to the model
